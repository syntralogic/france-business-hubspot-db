# Copy to .env, chmod 600, never commit. With docker compose, DATABASE_URL is built from POSTGRES_PASSWORD (this value is ignored there).
DATABASE_URL=postgresql://fbdb:CHANGE_ME@localhost:5432/fbdb
POSTGRES_PASSWORD=CHANGE_ME_long_random

# --- Sources (all optional except INSEE_API_KEY for the weekly delta; steps without keys are skipped and logged)
INSEE_API_KEY=
PAPPERS_API_KEY=
GOOGLE_PLACES_API_KEY=
LICENSED_CONTACTS_CONTRACT_REF=
INPI_USERNAME=
INPI_PASSWORD=
PAPPERS_DAILY_CAP=200
PLACES_DAILY_CAP=100

# --- Snapshot file of the whole database (scripts/snapshot.sh), written after each weekly run
SNAPSHOT_AFTER_WEEKLY=1
SNAPSHOT_KEEP_DAYS=28
# SNAPSHOT_DIR=data/backups

# --- Open-data files downloaded by the weekly run (no key needed)
DECP_AUTO=1
DECP_REFRESH_DAYS=30
# DECP_DATASET_ID=608c055b35eb4e6ee20eb325
# CSV link of the ADEME RGE list you use (no official permanent link is guessed); empty = the RGE step is skipped
RGE_CSV_URL=

# --- Weekly run tuning (defaults shown)
DIRECTORS_PER_RUN=5000
GEOCODE_PER_RUN=200000
BODACC_DAYS=8
INPI_PER_RUN=500
PAPPERS_PER_RUN=200
PLACES_PER_RUN=100
STEP_TIMEOUT_SECONDS=21600
# HubSpot CSV written by every weekly run into data/exports/<date>/
EXPORT_AFTER_WEEKLY=1
EXPORT_INCLUDE_CLOSED=0
EXPORT_SIRET_IS_IMPORT_KEY=0

# --- PostgreSQL memory (defaults suit a 2 vCPU / 4 GB pilot server). For 8 vCPU / 32 GB use:
# PG_SHARED_BUFFERS=4GB  PG_EFFECTIVE_CACHE_SIZE=16GB  PG_MAINTENANCE_WORK_MEM=1GB  PG_WORK_MEM=64MB  PG_MAX_WAL_SIZE=8GB

# --- Alerts and monitoring (see docs/15-deployment.md)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
HEALTHCHECK_PING_URL=
